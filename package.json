{
  "name": "penko-tune",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Privacy-first, open-source music player - A true Spotify alternative",
  "author": "Penko Software <contact@penkosoftware.org>",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NA-Ag/penko-tune"
  },
  "homepage": "https://tune.penkosoftware.org",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-icons": "node generate-icons.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@helia/unixfs": "^6.0.4",
    "@storacha/client": "^1.8.26",
    "d3": "^7.9.0",
    "helia": "^6.0.14",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "events": "^3.3.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "sharp": "^0.33.5",
    "stream-browserify": "^3.0.0",
    "typescript": "~5.8.2",
    "util": "^0.12.5",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "org.penkosoftware.tune",
    "productName": "Penko Tune",
    "icon": "public/pwa-512x512.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Audio"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
